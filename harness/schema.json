{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Scene-Deck playtest run record",
  "type": "object",
  "required": ["run_id", "batch_id", "arm", "seed", "spec_version", "status", "cohort_id", "assignments",
               "prep_packet", "events", "scenes", "referee", "surveys", "metrics", "tokens"],
  "properties": {
    "run_id": {"type": "string"},
    "batch_id": {"type": "string"},
    "arm": {"type": "string", "description": "A | B | C, or a variant such as B:FAE"},
    "seed": {"type": "integer"},
    "spec_version": {"type": "string"},
    "status": {"enum": ["partial", "complete", "invalid", "truncated", "failed", "crashed"]},
    "error": {"type": ["string", "null"]},
    "backend": {"enum": ["claude_cli", "scripted"]},
    "run_index": {"type": "integer"},
    "cohort_id": {"type": "string"},
    "assignments": {"type": "array", "items": {"type": "object",
      "required": ["character_id", "personality_id"],
      "properties": {"character_id": {"type": "string"}, "name": {"type": "string"},
                     "personality_id": {"type": "string"}, "seat": {"type": "integer"}}}},
    "prep_packet": {"type": "object", "required": ["anchors", "environment", "modules", "beat_frames"],
      "properties": {"anchors": {"type": "array"}, "environment": {"type": "array"},
                     "modules": {"type": "array"}, "beat_frames": {"type": "array"}}},
    "events": {"type": "array", "description": "One row per event. The §12 CSV columns plus harness-only fields.",
      "items": {"type": "object",
        "required": ["event_id", "session", "scene", "actor", "action", "skill", "tags_invoked", "fp_spent", "dice",
                     "total", "opposition", "result", "draw_id", "compel", "clock_change", "tension", "notes",
                     "event_type"]}},
    "scenes": {"type": "array", "items": {"type": "object",
      "required": ["index", "tension_before", "scene_test", "outcome"],
      "properties": {"index": {"type": "integer"}, "tension_before": {"type": ["integer", "null"]},
                     "scene_test": {"type": ["integer", "null"]}, "outcome": {"type": "string"},
                     "beat": {"type": ["string", "null"]}, "rounds": {"type": "integer"},
                     "climax": {"type": "boolean"}, "tension_after": {"type": ["integer", "null"]},
                     "triggers_fired": {"type": "array"}}}},
    "transcript": {"type": "array"},
    "costs": {"type": "array", "description": "Every cost/compel/fill built from a drawn card, with the engine's tag check."},
    "referee": {"type": "object", "required": ["violations", "ambiguities"],
      "properties": {
        "violations": {"type": "array"},
        "ambiguities": {"type": "array", "items": {"type": "object",
          "required": ["section", "issue", "interim_ruling"],
          "properties": {"id": {"type": "string"}, "section": {"type": "string"}, "issue": {"type": "string"},
                         "interim_ruling": {"type": "string"}, "source": {"enum": ["engine", "referee"]}}}},
        "cost_checks": {"type": "array"}, "friction": {"type": "array"}}},
    "surveys": {"type": "array", "items": {"type": "object",
      "required": ["personality_id", "scores", "free_text"],
      "properties": {"character_id": {"type": "string"}, "personality_id": {"type": "string"},
                     "scores": {"type": "object"}, "free_text": {"type": "object"}, "synthetic": {"type": "boolean"}}}},
    "interview": {"type": ["object", "null"]},
    "chronicle": {"type": ["object", "null"]},
    "state_end": {"type": "object"},
    "notes": {"type": "array"},
    "metrics": {"type": "object"},
    "tokens": {"type": "object", "required": ["prompt", "completion"],
      "properties": {"prompt": {"type": "integer"}, "completion": {"type": "integer"},
                     "cost_usd": {"type": "number"}, "calls": {"type": "integer"}}}
  }
}
